generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Company {
  id                 String             @id @default(uuid())
  name               String
  slug               String             @unique
  users              User[]
  employees          Employee[]
  departments        Department[]
  designations       Designation[]
  locations          Location[]
  leaveTypes         LeaveType[]
  jobs               Job[]
  candidates         Candidate[]
  performanceCycles  PerformanceCycle[]
  documentCategories DocumentCategory[]
  announcements      Announcement[]
  auditLogs          AuditLog[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
}

model AuditLog {
  id         String   @id @default(uuid())
  action     String
  method     String
  path       String
  statusCode Int
  ipAddress  String?
  userAgent  String?
  userId     String?
  companyId  String?
  company    Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  metadata   String?
  createdAt  DateTime @default(now())

  @@index([companyId, createdAt])
  @@index([userId, createdAt])
}

model Notification {
  id        String    @id @default(uuid())
  title     String
  message   String
  type      String    @default("INFO")
  actionUrl String?
  readAt    DateTime?
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  @@index([userId, readAt, createdAt])
}

model Announcement {
  id          String    @id @default(uuid())
  title       String
  body        String
  audience    String    @default("ALL")
  publishedAt DateTime?
  expiresAt   DateTime?
  authorId    String
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([companyId, publishedAt, expiresAt])
}

model DocumentCategory {
  id          String     @id @default(uuid())
  name        String
  description String?
  required    Boolean    @default(false)
  companyId   String
  company     Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  documents   Document[]
  createdAt   DateTime   @default(now())

  @@unique([companyId, name])
}

model Document {
  id            String           @id @default(uuid())
  name          String
  originalName  String
  storageKey    String           @unique
  mimeType      String
  sizeBytes     Int
  status        String           @default("PENDING")
  expiresAt     DateTime?
  verifiedAt    DateTime?
  verifiedById  String?
  rejectionNote String?
  employeeId    String
  categoryId    String
  employee      Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  category      DocumentCategory @relation(fields: [categoryId], references: [id])
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([employeeId, status])
  @@index([expiresAt])
}

model PerformanceCycle {
  id        String                 @id @default(uuid())
  name      String
  startDate DateTime
  endDate   DateTime
  status    String                 @default("DRAFT")
  companyId String
  company   Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  goals     PerformanceGoal[]
  reviews   PerformanceReview[]
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt

  @@unique([companyId, name])
  @@index([companyId, status])
}

model PerformanceGoal {
  id          String           @id @default(uuid())
  title       String
  description String?
  metric      String?
  target      String?
  weight      Int              @default(0)
  progress    Int              @default(0)
  status      String           @default("NOT_STARTED")
  dueDate     DateTime?
  employeeId  String
  cycleId     String
  employee    Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  cycle       PerformanceCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([employeeId, cycleId])
}

model PerformanceReview {
  id              String           @id @default(uuid())
  status          String           @default("PENDING_SELF_REVIEW")
  selfRating      Int?
  selfComments    String?
  managerRating   Int?
  managerComments String?
  finalRating     Int?
  hrComments      String?
  employeeId      String
  managerId       String?
  cycleId         String
  employee        Employee         @relation("ReviewEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  manager         Employee?        @relation("ReviewManager", fields: [managerId], references: [id])
  cycle           PerformanceCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([employeeId, cycleId])
  @@index([managerId, status])
}

model Job {
  id             String         @id @default(uuid())
  title          String
  description    String
  employmentType String         @default("FULL_TIME")
  status         String         @default("DRAFT")
  openings       Int            @default(1)
  departmentId   String?
  companyId      String
  company        Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  department     Department?    @relation(fields: [departmentId], references: [id])
  applications   Application[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([companyId, status])
}

model Candidate {
  id           String        @id @default(uuid())
  firstName    String
  lastName     String
  email        String
  phone        String?
  resumeUrl    String?
  source       String?
  companyId    String
  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  applications Application[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([companyId, email])
}

model Application {
  id          String            @id @default(uuid())
  status      String            @default("APPLIED")
  rating      Int?
  notes       String?
  jobId       String
  candidateId String
  job         Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  candidate   Candidate         @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  interviews  Interview[]
  appliedAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@unique([jobId, candidateId])
  @@index([jobId, status])
}

model Interview {
  id              String          @id @default(uuid())
  title           String
  scheduledAt     DateTime
  durationMinutes Int             @default(60)
  meetingUrl      String?
  interviewerId   String?
  feedback        String?
  status          String          @default("SCHEDULED")
  applicationId   String
  application     Application     @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([scheduledAt, status])
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  passwordHash  String
  role          String         @default("EMPLOYEE")
  isActive      Boolean        @default(true)
  companyId     String
  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee      Employee?
  notifications Notification[]
  refreshTokens RefreshToken[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([companyId])
}

model RefreshToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  @@index([userId, expiresAt])
}

model Department {
  id        String     @id @default(uuid())
  name      String
  companyId String
  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employees Employee[]
  jobs      Job[]

  @@unique([companyId, name])
}

model Designation {
  id        String     @id @default(uuid())
  title     String
  companyId String
  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employees Employee[]

  @@unique([companyId, title])
}

model Location {
  id        String     @id @default(uuid())
  name      String
  city      String
  country   String
  companyId String
  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employees Employee[]
  createdAt DateTime   @default(now())

  @@unique([companyId, name])
}

model Employee {
  id                 String              @id @default(uuid())
  employeeCode       String
  firstName          String
  lastName           String
  email              String
  phone              String?
  joiningDate        DateTime
  status             String              @default("ACTIVE")
  employmentType     String              @default("FULL_TIME")
  companyId          String
  departmentId       String?
  designationId      String?
  managerId          String?
  locationId         String?
  userId             String?             @unique
  company            Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  department         Department?         @relation(fields: [departmentId], references: [id])
  designation        Designation?        @relation(fields: [designationId], references: [id])
  manager            Employee?           @relation("EmployeeManager", fields: [managerId], references: [id])
  location           Location?           @relation(fields: [locationId], references: [id])
  reports            Employee[]          @relation("EmployeeManager")
  user               User?               @relation(fields: [userId], references: [id])
  attendance         Attendance[]
  leaveRequests      LeaveRequest[]
  leaveBalances      LeaveBalance[]
  salaryStructure    SalaryStructure?
  payrolls           Payroll[]
  performanceGoals   PerformanceGoal[]
  performanceReviews PerformanceReview[] @relation("ReviewEmployee")
  reviewsToManage    PerformanceReview[] @relation("ReviewManager")
  documents          Document[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@unique([companyId, employeeCode])
  @@unique([companyId, email])
  @@index([companyId, departmentId])
}

model SalaryStructure {
  id            String   @id @default(uuid())
  basicSalary   Decimal
  hra           Decimal  @default(0)
  allowances    Decimal  @default(0)
  employeeId    String   @unique
  employee      Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  effectiveFrom DateTime
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Payroll {
  id            String        @id @default(uuid())
  year          Int
  month         Int
  basicSalary   Decimal
  hra           Decimal
  allowances    Decimal
  bonus         Decimal       @default(0)
  overtime      Decimal       @default(0)
  tax           Decimal       @default(0)
  deductions    Decimal       @default(0)
  grossSalary   Decimal
  netSalary     Decimal
  status        String        @default("DRAFT")
  paidAt        DateTime?
  employeeId    String
  employee      Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  processedById String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@unique([employeeId, year, month])
  @@index([year, month, status])
}

model Attendance {
  id           String           @id @default(uuid())
  date         DateTime
  checkIn      DateTime?
  checkOut     DateTime?
  breakMinutes Int              @default(0)
  notes        String?
  status       String           @default("PRESENT")
  employeeId   String
  employee     Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  createdAt    DateTime         @default(now())

  @@unique([employeeId, date])
}

model LeaveType {
  id          String         @id @default(uuid())
  name        String
  daysPerYear Int
  companyId   String
  company     Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  requests    LeaveRequest[]
  balances    LeaveBalance[]
  createdAt   DateTime       @default(now())

  @@unique([companyId, name])
}

model LeaveBalance {
  id          String    @id @default(uuid())
  year        Int
  allocated   Float
  used        Float     @default(0)
  employeeId  String
  leaveTypeId String
  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType   LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, leaveTypeId, year])
}

model LeaveRequest {
  id           String      @id @default(uuid())
  startDate    DateTime
  endDate      DateTime
  reason       String
  status       String      @default("PENDING")
  days         Float
  reviewNote   String?
  reviewedById String?
  reviewedAt   DateTime?
  employeeId   String
  leaveTypeId  String
  employee     Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType    LeaveType   @relation(fields: [leaveTypeId], references: [id])
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}
